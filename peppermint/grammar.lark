// Peppermint grammar
// Newlines inside ( ) [ ] { } are ignored — JS-style.
// Newlines at statement level terminate statements.
// No tuple literals — (a, b) is only valid as call args or lambda params.

program: (_NL | statement)*

statement: assign
         | use_decl
         | ns_decl
         | expr
         | cont_pipe

cont_pipe: ("|>" pipe_step)+

assign: NAME "=" expr

use_decl: "use" (NAME | ESCAPED_STRING) ("as" NAME)?

ns_decl: "ns" NAME "{" (_NL | assign)* "}"

// Expression hierarchy — lowest precedence at top
?expr: lambda_expr

ARROW: "->"

?lambda_expr: pipe_expr
            | NAME ARROW expr                                                    -> lambda_expr
            | "(" params ")" ARROW expr                                         -> lambda_expr
            | "(" ")" ARROW expr                                                -> lambda_expr_noargs
            | NAME ARROW "(" paren_body ")"                                     -> lambda_body
            | "(" params ")" ARROW "(" paren_body ")"                          -> lambda_body
            | "(" ")" ARROW "(" paren_body ")"                                 -> lambda_body_noargs

// Comma-separated parameter names for lambda definitions (2+ names)
params: NAME "," _NL* NAME ("," _NL* NAME)*

?pipe_expr: cmp_expr
          | pipe_expr "|>" pipe_step

pipe_step: postfix QUIET?
QUIET: "quiet"

?cmp_expr: add_expr
         | cmp_expr GT  add_expr  -> binop
         | cmp_expr LT  add_expr  -> binop
         | cmp_expr GTE add_expr  -> binop
         | cmp_expr LTE add_expr  -> binop
         | cmp_expr EQ  add_expr  -> binop
         | cmp_expr NEQ add_expr  -> binop

?add_expr: mul_expr
         | add_expr PLUS  mul_expr -> binop
         | add_expr MINUS mul_expr -> binop

?mul_expr: unary_expr
         | mul_expr STAR  unary_expr -> binop
         | mul_expr SLASH unary_expr -> binop
         | mul_expr MOD   unary_expr -> binop

?unary_expr: postfix
           | MINUS postfix -> neg

GT:    ">"
LT:    "<"
GTE:   ">="
LTE:   "<="
EQ:    "=="
NEQ:   "!="
PLUS:  "+"
MINUS: "-"
STAR:  "*"
SLASH: "/"
MOD:   "%"

// Postfix: field access and calls — left-associative
?postfix: atom
        | postfix "." NAME                      -> field_access
        | postfix "(" _NL* ")"                  -> call_expr
        | postfix "(" arglist ")"               -> call_expr
        | postfix "(" _NL* ")" block            -> call_with_block
        | postfix "(" arglist ")" block         -> call_with_block

// Atom: base expressions — no tuple literals
?atom: NAME                   -> ident
     | INT                    -> int_lit
     | FLOAT                  -> float_lit
     | ESCAPED_STRING         -> str_lit
     | "true"                 -> true_lit
     | "false"                -> false_lit
     | "none"                 -> none_lit
     | "(" _NL* expr _NL* ")"
     | "(" _NL* paren_seq _NL* ")"
     | list_lit
     | obj_lit
     | match_expr
     | range_expr
     | spread_expr

// paren_seq: multiple expressions separated by newlines inside parens
paren_seq: expr (_NL+ expr)+          -> seq_expr

spread_expr: "..." postfix

range_expr: INT_RANGE
INT_RANGE.2: /\d+\.\.\d+/

list_lit: "[" _NL* "]"
        | "[" _NL* expr (_NL* "," _NL* expr)* ","? _NL* "]"

obj_lit: "{" _NL* "}"
       | "{" _NL* obj_entry (_NL* "," _NL* obj_entry)* ","? _NL* "}"
obj_entry: "..." postfix  -> obj_spread
         | NAME ":" expr  -> obj_field
         | NAME            -> obj_shorthand

block: "{" _NL* ("|>" pipe_step _NL*)+ "}"

arglist: _NL* arg ("," _NL* arg)* ","? _NL*
arg: NAME ":" _NL* expr  -> kwarg
   | expr                 -> posarg

// paren_body: right-recursive so LALR can commit without lookahead
// Each paren_more is another _NL-separated item; trailing _NL absorbed by paren_more
paren_body: _NL? paren_item paren_more
paren_more: _NL paren_item paren_more
           | _NL
           |
paren_item: expr ("|>" pipe_step)*

// Match
match_expr: "match" "(" _NL* expr _NL* "," _NL* match_arm (_NL* "," _NL* match_arm)* ","? _NL* ")"
match_arm: pattern ":" expr

pattern: ">"  pat_val  -> pat_gt
       | "<"  pat_val  -> pat_lt
       | ">=" pat_val  -> pat_gte
       | "<=" pat_val  -> pat_lte
       | "==" pat_val  -> pat_eq
       | "!=" pat_val  -> pat_neq
       | "Ok"  "(" NAME ")"  -> pat_ok
       | "Err" "(" NAME ")"  -> pat_err
       | "_"               -> pat_wildcard

pat_val: INT | FLOAT | ESCAPED_STRING | NAME
literal: INT | FLOAT | ESCAPED_STRING

// Terminals
_NL: /[\n;]+/
NAME: /(?!(true|false|none|ns|use|as|quiet)\b)[a-zA-Z_][a-zA-Z0-9_]*/

%import common.INT
%import common.FLOAT
%import common.ESCAPED_STRING
%import common.WS_INLINE
%import common.NEWLINE

%ignore WS_INLINE
%ignore /#[^\n]*/

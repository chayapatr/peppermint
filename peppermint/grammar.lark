// Peppermint grammar
// Newlines inside ( ) [ ] { } are always ignored — JS-style.
// Newlines at statement level are significant (they terminate statements).

program: (_NEWLINE | _SEMI | statement)*

_SEMI: ";"

statement: assign
         | use_decl
         | ns_decl
         | expr
         | cont_pipe

// A continuation pipe: starts with |> and attaches to previous statement
cont_pipe: ("|>" pipe_step)+

assign: NAME "=" expr

use_decl: "use" (NAME | ESCAPED_STRING) ("as" NAME)?

ns_decl: "ns" NAME "{" (_NL | assign)* "}"

// Expression hierarchy — lowest precedence at top
?expr: lambda_expr

ARROW: "->"

// Lambda params: trailing NL absorbed after each NAME, before ")" or ","
_lambda_params: NAME (_NL* "," _NL* NAME)*

?lambda_expr: pipe_expr
            | NAME ARROW expr                                                         -> lambda_expr
            | "(" _NL* _lambda_params _NL* ")" ARROW expr                            -> lambda_expr
            | "(" _NL* ")" ARROW expr                                                 -> lambda_expr_noargs
            | NAME ARROW "(" _NL* paren_expr _NL* ")"                               -> lambda_body
            | "(" _NL* _lambda_params _NL* ")" ARROW "(" _NL* paren_expr _NL* ")"   -> lambda_body
            | "(" _NL* ")" ARROW "(" _NL* paren_expr _NL* ")"                       -> lambda_body_noargs

?pipe_expr: cmp_expr
          | pipe_expr "|>" pipe_step

pipe_step: postfix QUIET?
QUIET: "quiet"

?cmp_expr: add_expr
         | cmp_expr GT  add_expr  -> binop
         | cmp_expr LT  add_expr  -> binop
         | cmp_expr GTE add_expr  -> binop
         | cmp_expr LTE add_expr  -> binop
         | cmp_expr EQ  add_expr  -> binop
         | cmp_expr NEQ add_expr  -> binop

?add_expr: mul_expr
         | add_expr PLUS  mul_expr -> binop
         | add_expr MINUS mul_expr -> binop

?mul_expr: unary_expr
         | mul_expr STAR  unary_expr  -> binop
         | mul_expr SLASH unary_expr  -> binop
         | mul_expr MOD   unary_expr  -> binop

?unary_expr: postfix
           | MINUS postfix  -> neg

GT:    ">"
LT:    "<"
GTE:   ">="
LTE:   "<="
EQ:    "=="
NEQ:   "!="
PLUS:  "+"
MINUS: "-"
STAR:  "*"
SLASH: "/"
MOD:   "%"

// Postfix: field access and calls, left-associative
?postfix: atom
        | postfix "." NAME                         -> field_access
        | postfix "(" _NL* arglist? _NL* ")"       -> call_expr
        | postfix "(" _NL* arglist? _NL* ")" block -> call_with_block

// Atom: base expressions
?atom: NAME                                              -> ident
     | INT                                               -> int_lit
     | FLOAT                                             -> float_lit
     | ESCAPED_STRING                                    -> str_lit
     | "true"                                            -> true_lit
     | "false"                                           -> false_lit
     | "none"                                            -> none_lit
     | "(" _NL* expr _NL* ")"
     | tuple_lit
     | "(" _NL* expr (_NL+ expr)+ _NL* ")"              -> seq_expr
     | list_lit
     | obj_lit
     | match_expr
     | range_expr
     | spread_expr

// paren_expr: sequence of exprs separated by NL/; with optional pipe continuations
paren_expr: paren_stmt (_NL+ paren_stmt)* -> paren_seq
paren_stmt: expr (_NL* "|>" pipe_step)*   -> paren_pipe

spread_expr: "..." postfix

range_expr: INT ".." INT

list_lit: "[" _NL* (expr (_NL* "," _NL* expr)* ","?)? _NL* "]"

obj_lit: "{" _NL* (obj_entry ("," _NL* obj_entry)* ","?)? _NL* "}"
obj_entry: "..." postfix  -> obj_spread
         | NAME ":" expr  -> obj_field
         | NAME            -> obj_shorthand

// Block: sub-pipe steps inside { }
block: "{" _NL* ("|>" pipe_step _NL*)+ "}"

arglist: arg ("," _NL* arg)* ","?
arg: NAME ":" _NL* expr  -> kwarg
   | expr                 -> posarg

// Match — newlines allowed freely inside ( )
match_expr: "match" "(" _NL* expr _NL* "," _NL* match_arm ("," _NL* match_arm)* ","? _NL* ")"
match_arm: pattern ":" expr

pattern: ">"  pat_val  -> pat_gt
       | "<"  pat_val  -> pat_lt
       | ">=" pat_val  -> pat_gte
       | "<=" pat_val  -> pat_lte
       | "==" pat_val  -> pat_eq
       | "!=" pat_val  -> pat_neq
       | "Ok"  "(" NAME ")"                          -> pat_ok
       | "Err" "(" NAME ")"                          -> pat_err
       | "(" pattern ("," _NL* pattern)+ ")"         -> pat_tuple
       | "_"                                         -> pat_wildcard

pat_val: INT | FLOAT | ESCAPED_STRING | NAME
literal: INT | FLOAT | ESCAPED_STRING

tuple_lit.-1: "(" _NL* expr ("," _NL* expr)+ _NL* ")"

// _NL: silent newline/semicolon — ignored inside brackets
_NL: NEWLINE | ";"

// Terminals
NAME: /(?!(true|false|none|ns|use|as|quiet)\b)[a-zA-Z_][a-zA-Z0-9_]*/

%import common.INT
%import common.FLOAT
%import common.ESCAPED_STRING
%import common.WS_INLINE
%import common.NEWLINE

_NEWLINE: NEWLINE
%ignore WS_INLINE
%ignore /#[^\n]*/

{
  "name": "vscode-peppermint",
  "displayName": "Peppermint",
  "description": "Language support for Peppermint (.pep) files",
  "version": "0.2.0",
  "publisher": "peppermint",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:peppermint"
  ],
  "contributes": {
    "languages": [
      {
        "id": "peppermint",
        "aliases": [
          "Peppermint",
          "pep"
        ],
        "extensions": [
          ".pep"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "peppermint",
        "scopeName": "source.pep",
        "path": "./syntaxes/peppermint.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chayapatr/peppermint"
  },
  "scripts": {
    "compile": "esbuild extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
    "vscode:prepublish": "npm run compile"
  }
}
